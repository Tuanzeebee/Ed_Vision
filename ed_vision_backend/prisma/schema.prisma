generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Meeting type for slots & appointments. Values intentionally lowercase to match frontend strings.
enum MeetingType {
  online
  offline
  both
}

enum RecipientRole {
  booker
  instructor
}

model Account {
  account_id                 Int                             @id @default(autoincrement())
  email                      String                          @unique @db.VarChar(255)
  password_hash              String
  status                     String?                         @default("active") @db.VarChar(20)
  created_at                 DateTime                        @default(now()) @db.Timestamptz(6)
  last_login_at              DateTime?                       @db.Timestamptz(6)
  last_logout_at             DateTime?                       @db.Timestamptz(6)
  role_id                    Int?
  updated_at                 DateTime                        @default(now()) @db.Timestamptz(6)
  roleRel                    Role?                           @relation(fields: [role_id], references: [id])
  appointmentsBooked         Appointment[]
  instructor                 Instructor?
  otps                       Otp[]
  parent                     Parent?
  profile                    Profile?
  student                    Student?
  surveyResponses            SurveyResponse[]
  createdSurveys             Survey[]                        @relation("AccountCreatedSurveys")
  notifications              Notification[] // In-app notifications delivered to this account
  reminderSchedules          ReminderSchedule[] // Scheduled reminders targeting this account
  notificationMastersCreated NotificationMaster[]            @relation("NotificationMasterCreator") // Notifications created by this account (admin)
  notificationRecipients     NotificationRecipient[] // Notifications received by this account
  deviceFingerprints         DeviceFingerprint[] // Device fingerprints for attendance verification
  approvedAttempts           AttendanceVerificationAttempt[] @relation("AttendanceApprover") // Attempts approved by this account
  verificationAttempts       AttendanceVerificationAttempt[] // All verification attempts by this account
  hostedRooms                Room[]                          @relation("RoomHost")
  roomParticipants           RoomParticipant[]
  roomActions                RoomAction[]                    @relation("RoomActionTarget")
  roomBans                   RoomBan[]
  studySessions              StudySession[]
  dailyStreak                DailyStreak?
  studyStat                  StudyStat?
  leaderboard                Leaderboard?

  @@map("Account")
}

model Profile {
  profile_id    Int       @id @default(autoincrement())
  account_id    Int       @unique
  full_name     String    @db.VarChar(150)
  phone_number  String?   @db.VarChar(30)
  date_of_birth DateTime? @db.Date
  gender        String?   @db.VarChar(16)
  address       String?
  avatar_url    String?
  nationality   String?   @db.VarChar(80)
  account       Account   @relation(fields: [account_id], references: [account_id], onDelete: Cascade)

  @@map("Profile")
}

model Parent {
  parent_id          Int                 @id @default(autoincrement())
  account_id         Int                 @unique
  relationship_type  String?             @db.VarChar(32)
  occupation         String?             @db.VarChar(120)
  workplace          String?             @db.VarChar(255)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  account            Account             @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  parentStudentLinks ParentStudentLink[]

  @@map("Parent")
}

model Student {
  student_id             Int                     @id @default(autoincrement())
  account_id             Int                     @unique
  student_code           String                  @unique @db.VarChar(50)
  major                  String?                 @db.VarChar(120)
  cohort_year            Int?
  class_id               Int?
  status                 String?                 @default("active") @db.VarChar(20)
  appointments           Appointment[]
  parentStudentLinks     ParentStudentLink[]
  account                Account                 @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  classGroup             ClassGroup?             @relation(fields: [class_id], references: [class_id])
  courseRecords          StudentCourseRecord[]
  predictionResults      PredictionResult[]
  surveyFactors          StudentSurveyFactors?
  attendanceSessions     AttendanceSession[] // Offline attendance sessions for this student
  certificateEnrollments CertificateEnrollment[] // Certificate band enrollments

  @@map("Student")
}

model Instructor {
  instructor_id               Int                          @id @default(autoincrement())
  account_id                  Int                          @unique
  employee_code               String                       @unique @db.VarChar(50)
  academic_title              String?                      @db.VarChar(100)
  position                    String?                      @db.VarChar(100)
  department_id               Int?
  hire_date                   DateTime?                    @db.Date
  status                      String?                      @default("active") @db.VarChar(20)
  adviserAssignments          AdviserAssignment[]
  appointments                Appointment[]
  account                     Account                      @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  department                  Department?                  @relation(fields: [department_id], references: [department_id])
  instructorAvailabilityWeeks InstructorAvailabilityWeek[]
  predictionResults           PredictionResult[]
  attendanceSessions          AttendanceSession[] // Offline attendance sessions created by this instructor

  @@map("Instructor")
}

model Department {
  department_id Int          @id @default(autoincrement())
  code          String?      @unique @db.VarChar(20)
  name          String       @db.VarChar(150)
  status        String?      @default("active") @db.VarChar(20)
  instructors   Instructor[]
  programs      Program[]

  @@map("Department")
}

model Program {
  program_id        Int                @id @default(autoincrement())
  program_code      String             @unique @db.VarChar(20)
  program_name      String             @db.VarChar(255)
  duration_years    Int?               @default(4) @db.SmallInt
  department_id     Int
  classGroups       ClassGroup[]
  curriculumCourses CurriculumCourse[]
  department        Department         @relation(fields: [department_id], references: [department_id])

  @@map("Program")
}

model ClassGroup {
  class_id           Int                 @id @default(autoincrement())
  class_code         String              @unique @db.VarChar(30)
  program_id         Int?
  cohort_year        Int
  status             String?             @default("active") @db.VarChar(20)
  adviserAssignments AdviserAssignment[]
  program            Program?            @relation(fields: [program_id], references: [program_id])
  students           Student[]

  @@map("ClassGroup")
}

model AdviserAssignment {
  adviser_assign_id Int        @id @default(autoincrement())
  class_id          Int
  instructor_id     Int
  assigned_date     DateTime?  @db.Date
  ended_date        DateTime?  @db.Date
  note              String?
  classGroup        ClassGroup @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  instructor        Instructor @relation(fields: [instructor_id], references: [instructor_id], onDelete: Cascade)

  @@unique([class_id, instructor_id])
  @@map("AdviserAssignment")
}

model ParentStudentLink {
  link_id    Int      @id @default(autoincrement())
  parent_id  Int?
  student_id Int
  link_code  String?  @unique @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  parent     Parent?  @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade)
  student    Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([parent_id, student_id])
  @@map("ParentStudentLink")
}

model AcademicTerm {
  term_id              Int                   @id @default(autoincrement())
  academic_year        String                @db.VarChar(20)
  semester_number      Int                   @db.SmallInt
  is_summer            Boolean               @default(false)
  status               String?               @default("active") @db.VarChar(20)
  studentCourseRecords StudentCourseRecord[]
  predictionResults    PredictionResult[]

  @@unique([academic_year, semester_number])
  @@map("AcademicTerm")
}

model Course {
  course_id            Int                   @id @default(autoincrement())
  course_code          String                @db.VarChar(20)
  course_name          String                @db.VarChar(255)
  credits_unit         Int?                  @db.SmallInt
  study_format         String?               @default("offline") @db.VarChar(20)
  language             String?               @db.VarChar(30)
  difficulty           String?               @db.VarChar(20)
  description          String?
  curriculumCourses    CurriculumCourse[]
  studentCourseRecords StudentCourseRecord[]
  predictionResults    PredictionResult[]

  @@unique([course_code, study_format])
  @@map("Course")
}

model CurriculumCourse {
  id           Int     @id @default(autoincrement())
  program_id   Int
  course_id    Int
  year_number  Int     @db.SmallInt
  term_number  Int     @db.SmallInt
  is_mandatory Boolean @default(true)
  note         String?
  course       Course  @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  program      Program @relation(fields: [program_id], references: [program_id], onDelete: Cascade)

  @@unique([program_id, course_id])
  @@map("CurriculumCourse")
}

model StudentCourseRecord {
  record_id               Int           @id @default(autoincrement())
  student_id              Int?
  course_id               Int?
  term_id                 Int?
  status                  String?       @default("planned") @db.VarChar(20)
  raw_score               Decimal?      @db.Decimal(5, 2)
  converted_score         String?       @db.VarChar(5)
  converted_numeric_score Decimal?      @db.Decimal(5, 2)
  course                  Course?       @relation(fields: [course_id], references: [course_id])
  student                 Student?      @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  academicTerm            AcademicTerm? @relation(fields: [term_id], references: [term_id])

  @@unique([student_id, course_id])
  @@map("StudentCourseRecord")
}

model SurveyQuestion {
  question_id   Int                  @id @default(autoincrement())
  question_text String
  question_type String?              @db.VarChar(20)
  category      String?              @db.VarChar(50)
  is_active     Boolean              @default(true)
  code          String?              @unique @db.VarChar(100) // Identifier ổn định, e.g., 'study_time'
  min_value     Float? // Min cho slider
  max_value     Float? // Max cho slider
  surveyAnswers SurveyAnswer[]
  surveyOptions SurveyOption[]
  questionLinks SurveyQuestionLink[]

  @@map("SurveyQuestion")
}

model SurveyOption {
  option_id     Int             @id @default(autoincrement())
  question_id   Int?
  option_text   String?
  option_value  Int?
  surveyAnswers SurveyAnswer[]
  question      SurveyQuestion? @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@map("SurveyOption")
}

model SurveyResponse {
  response_id   Int            @id @default(autoincrement())
  account_id    Int?
  survey_id     Int?
  submitted_at  DateTime       @default(now()) @db.Timestamptz(6)
  surveyAnswers SurveyAnswer[]
  account       Account?       @relation(fields: [account_id], references: [account_id])
  survey        Survey?        @relation(fields: [survey_id], references: [survey_id], onDelete: Cascade)

  @@map("SurveyResponse")
}

model SurveyAnswer {
  answer_id   Int             @id @default(autoincrement())
  response_id Int?
  question_id Int?
  option_id   Int?
  free_text   String?
  option      SurveyOption?   @relation(fields: [option_id], references: [option_id])
  question    SurveyQuestion? @relation(fields: [question_id], references: [question_id], onDelete: Cascade)
  response    SurveyResponse? @relation(fields: [response_id], references: [response_id], onDelete: Cascade)

  @@map("SurveyAnswer")
}

model Survey {
  survey_id       Int                  @id @default(autoincrement())
  title           String
  description     String?
  created_by      Int? // account_id của admin hoặc giảng viên
  created_at      DateTime             @default(now()) @db.Timestamptz(6)
  start_date      DateTime?            @db.Timestamptz(6)
  end_date        DateTime?            @db.Timestamptz(6)
  is_active       Boolean              @default(true)
  type            String?              @db.VarChar(30) // 'input', 'periodic', etc.
  target_role     String?              @db.VarChar(20) // 'student', 'teacher', 'parent'
  surveyQuestions SurveyQuestionLink[]
  surveyResponses SurveyResponse[]
  createdBy       Account?             @relation("AccountCreatedSurveys", fields: [created_by], references: [account_id], onDelete: SetNull)

  @@map("Survey")
}

model SurveyQuestionLink {
  id          Int            @id @default(autoincrement())
  survey_id   Int
  question_id Int
  order_index Int? // để sắp xếp câu hỏi
  survey      Survey         @relation(fields: [survey_id], references: [survey_id], onDelete: Cascade)
  question    SurveyQuestion @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@unique([survey_id, question_id])
  @@map("SurveyQuestionLink")
}

model InstructorAvailabilityWeek {
  week_id                     Int                          @id @default(autoincrement())
  instructor_id               Int?
  week_start_date             DateTime                     @db.Date
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  instructorAvailabilityDates InstructorAvailabilityDate[]
  instructor                  Instructor?                  @relation(fields: [instructor_id], references: [instructor_id], onDelete: Cascade)

  @@unique([instructor_id, week_start_date])
  @@map("InstructorAvailabilityWeek")
}

model InstructorAvailabilityDate {
  date_id       Int                        @id @default(autoincrement())
  week_id       Int
  specific_date DateTime                   @db.Date
  is_available  Boolean                    @default(true)
  note          String?
  created_at    DateTime                   @default(now()) @db.Timestamptz(6)
  week          InstructorAvailabilityWeek @relation(fields: [week_id], references: [week_id], onDelete: Cascade)
  slots         InstructorDailySlot[]

  @@unique([week_id, specific_date])
  @@map("InstructorAvailabilityDate")
}

model InstructorDailySlot {
  slot_id          Int           @id @default(autoincrement())
  date_id          Int // NEW: replace week_id + day_of_week
  start_time_local DateTime?     @db.Time(6)
  end_time_local   DateTime?     @db.Time(6)
  period_label     String?       @db.VarChar(16)
  capacity         Int           @default(10) @db.SmallInt
  is_open          Boolean       @default(true)
  note             String?
  auto_accept      Boolean       @default(false)
  meeting_link     String?
  meeting_location String?
  meeting_type     MeetingType?  @default(offline)
  appointments     Appointment[]

  date InstructorAvailabilityDate @relation(fields: [date_id], references: [date_id], onDelete: Cascade)

  @@unique([date_id, start_time_local])
  @@map("InstructorDailySlot")
}

model Appointment {
  appointment_id        Int                 @id @default(autoincrement())
  slot_id               Int
  booker_account_id     Int
  booker_role           String              @db.VarChar(20)
  student_id            Int?
  instructor_id         Int?
  meeting_purpose       String?             @db.VarChar(255)
  status                String              @default("pending") @db.VarChar(32)
  cancel_reason         String?
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?           @db.Timestamptz(6)
  canceled_at           DateTime?           @db.Timestamptz(6)
  attendance_checked_at DateTime?           @db.Timestamptz(6)
  attendance_status     String?             @db.VarChar(20)
  attended              Boolean?
  meeting_type          MeetingType
  booker                Account             @relation(fields: [booker_account_id], references: [account_id])
  instructor            Instructor?         @relation(fields: [instructor_id], references: [instructor_id])
  slot                  InstructorDailySlot @relation(fields: [slot_id], references: [slot_id], onDelete: Cascade)
  student               Student?            @relation(fields: [student_id], references: [student_id])
  appointmentContact    AppointmentContact?
  reminderSchedules     ReminderSchedule[]
  attendanceSessions    AttendanceSession[] // Offline attendance verification sessions (one-to-many)

  @@map("Appointment")
}

model AppointmentContact {
  appointment_id          Int         @id
  contact_name            String?     @db.VarChar(150)
  contact_phone           String?     @db.VarChar(30)
  contact_email           String?     @db.VarChar(255)
  relationship_to_student String?     @db.VarChar(64)
  appointment             Appointment @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade)

  @@map("AppointmentContact")
}

// Notification templates store reusable message templates. Use `code` as a stable lookup key
// (e.g. "appointment.created", "survey.reminder"). `content` may contain placeholders
// like `{student_name}` or `{date}` that will be replaced when rendering a `Notification`.
model NotificationTemplate {
  template_id Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(120) // Stable unique key (e.g. "appointment.created")
  title       String?  @db.VarChar(255) // Optional human-friendly title
  content     String // Template body; may include placeholders
  channel     String?  @db.VarChar(20) // Default channel: 'email' | 'in_app' | 'both'
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  notifications       Notification[] // Back-relation: notifications generated from this template
  reminderSchedules   ReminderSchedule[] // Back-relation: reminder schedules referencing this template by `code`
  notificationMasters NotificationMaster[] // Back-relation: master notifications using this template

  @@map("NotificationTemplate")
}

// Master notification: 1 row per broadcast (admin gửi 1 thông báo = 1 row)
model NotificationMaster {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  body        String
  type        String?  @db.VarChar(100) // 'Lịch Thi', 'Cập Nhật Hệ Thống', 'Cuộc Hẹn', etc.
  priority    String?  @db.VarChar(20) // 'Cao', 'Trung bình', 'Thấp'
  target      String?  @db.VarChar(100) // 'Sinh viên', 'Giảng viên', 'Phụ huynh', 'Tất cả', etc.
  channel     String?  @db.VarChar(20) // 'in_app' | 'email' | 'both'
  attachments Json? // JSON array: [{name, size, type, url}]
  created_by  Int // Account ID của admin tạo thông báo
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  template_id Int? // Optional template reference

  creator    Account                 @relation("NotificationMasterCreator", fields: [created_by], references: [account_id], onDelete: Cascade)
  template   NotificationTemplate?   @relation(fields: [template_id], references: [template_id], onDelete: SetNull)
  recipients NotificationRecipient[]

  @@map("NotificationMaster")
}

// Recipient notification: 1 row per user nhận thông báo
model NotificationRecipient {
  id           Int       @id @default(autoincrement())
  master_id    Int // Reference to NotificationMaster
  account_id   Int // Người nhận
  is_read      Boolean   @default(false)
  read_at      DateTime? @db.Timestamptz(6)
  delivered_at DateTime? @db.Timestamptz(6) // Thời điểm gửi thành công

  master  NotificationMaster @relation(fields: [master_id], references: [id], onDelete: Cascade)
  account Account            @relation(fields: [account_id], references: [account_id], onDelete: Cascade)

  @@unique([master_id, account_id]) // Mỗi user chỉ nhận 1 lần mỗi thông báo
  @@index([account_id])
  @@index([master_id])
  @@map("NotificationRecipient")
}

// Legacy: Rendered notifications delivered to accounts (in-app) - kept for backward compatibility
// Consider migrating to NotificationMaster + NotificationRecipient
model Notification {
  notification_id Int      @id @default(autoincrement())
  account_id      Int // Receiver account
  title           String   @db.VarChar(255)
  body            String
  type            String?  @db.VarChar(50)
  priority        String?  @db.VarChar(20)
  attachments     Json?
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  template_id     Int?

  account  Account               @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [template_id], references: [template_id], onDelete: SetNull)

  @@map("Notification")
}

// Draft notifications created by admin before sending
model NotificationDraft {
  draft_id    Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  content     String
  type        String   @db.VarChar(100)
  target      String   @db.VarChar(100)
  priority    String   @db.VarChar(20)
  attachments Json?
  created_by  Int? // Admin who created the draft
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("NotificationDraft")
}

// Notification history for tracking sent/deleted notifications (admin stats)
model NotificationHistory {
  history_id       Int      @id @default(autoincrement())
  action           String   @db.VarChar(20) // 'sent' | 'deleted'
  title            String   @db.VarChar(255)
  content          String
  type             String   @db.VarChar(100)
  target           String   @db.VarChar(100)
  priority         String   @db.VarChar(20)
  attachments      Json?
  total_recipients Int      @default(0)
  read_count       Int      @default(0)
  action_date      DateTime @default(now()) @db.Timestamptz(6)
  created_date     DateTime @db.Timestamptz(6)
  master_id        Int? // Optional link to NotificationMaster

  @@map("NotificationHistory")
}

// Generic reminder schedule. Can reference a `NotificationTemplate` by its `code`, or
// be tied to an `appointment` via `appointment_id`. `metadata` stores placeholders
// used to render the template (JSON), for example: { "student_name": "Alice", "date": "..." }.
model ReminderSchedule {
  reminder_id    Int           @id @default(autoincrement())
  appointment_id Int? // Optional appointment link
  account_id     Int // Who will receive the reminder
  recipient_role RecipientRole @default(booker)
  template_code  String        @db.VarChar(120) // Maps to NotificationTemplate.code
  remind_at      DateTime      @db.Timestamptz(6) // When to send
  sent_at        DateTime?     @db.Timestamptz(6) // When it was sent (null = not sent)
  channel        String?       @db.VarChar(32) // Preferred channel for this schedule
  metadata       Json? // JSON payload for rendering template placeholders
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  canceled       Boolean       @default(false)

  appointment Appointment?          @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade)
  account     Account               @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  template    NotificationTemplate? @relation(fields: [template_code], references: [code])

  @@unique([appointment_id, account_id, remind_at, template_code, recipient_role])
  @@index([remind_at, sent_at])
  @@map("ReminderSchedule")
}

/// OTPs for account verification / password reset
model Otp {
  otp_id     Int      @id @default(autoincrement())
  account_id Int
  code       String   @db.VarChar(10)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  account    Account  @relation(fields: [account_id], references: [account_id], onDelete: Cascade)

  @@index([account_id])
  @@map("Otp")
}

/// Role-based permissions persisted for roles (admin-managed)
model Role {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(150)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  accounts        Account[]
  rolePermissions RolePermission[]

  @@map("Role")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique @db.VarChar(200)
  name            String           @db.VarChar(200)
  category        String?          @db.VarChar(120)
  description     String?
  sensitive       Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("Permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  enabled      Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("RolePermission")
}

model EventLog {
  id                    Int       @id @default(autoincrement())
  table_name            String
  operation             String
  record_id             Int?
  payload               Json? // Prisma hỗ trợ kiểu JSON -> ánh xạ sang JSONB trong PostgreSQL
  created_at            DateTime  @default(now())
  processed             Boolean   @default(false)
  processed_at          DateTime? @db.Timestamptz(6)
  processing            Boolean   @default(false)
  processing_by         String?
  processing_started_at DateTime? @db.Timestamptz(6)
  retry_count           Int       @default(0)
  last_error            String?
  failed                Boolean   @default(false)

  @@index([failed, processed, processing, created_at(sort: Desc)], name: "idx_eventlog_unprocessed")
  @@index([table_name, created_at(sort: Desc)], name: "idx_eventlog_table_created_at")
  @@map("EventLog")
}

