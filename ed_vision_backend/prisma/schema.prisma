  @@map("RoomBan")
}

model StudySession {
  id               Int       @id @default(autoincrement())
  account_id       Int
  room_id          Int?
  started_at       DateTime  @db.Timestamptz(6)
  ended_at         DateTime? @db.Timestamptz(6)
  duration_minutes Int?
  account          Account   @relation(fields: [account_id], references: [account_id])
  room             Room?     @relation(fields: [room_id], references: [room_id])

  @@index([account_id])
  @@index([started_at])
  @@map("StudySession")
}

model DailyStreak {
  account_id      Int       @id
  current_streak  Int       @default(0)
  longest_streak  Int       @default(0)
  last_study_date DateTime? @db.Date
  account         Account   @relation(fields: [account_id], references: [account_id])

  @@map("DailyStreak")
}

model StudyStat {
  account_id     Int      @id
  total_minutes  Int      @default(0)
  total_sessions Int      @default(0)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  account        Account  @relation(fields: [account_id], references: [account_id])

  @@map("StudyStat")
}

model Leaderboard {
  account_id Int      @id
  score      Int?
  rank       Int?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  account    Account  @relation(fields: [account_id], references: [account_id])

  @@map("Leaderboard")
}

model IeltsAdaptiveRoadmap {
  id                     Int                   @id @default(autoincrement())
  enrollment_id          Int                   @unique
  current_band           Float
  target_band            Float
  target_completion_date DateTime?             @db.Timestamptz(6)
  roadmap_version        Int                   @default(1)
  difficulty_level       String
  lesson_sequence        Int[]
  current_lesson_index   Int                   @default(0)
  status                 String                @default("active")
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @updatedAt @db.Timestamptz(6)
  enrollment             CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  band_tests             IeltsBandTest[]
  lessons                IeltsLesson[]

  @@map("IeltsAdaptiveRoadmap")
