// ─────────────────────────────────────────────────────────────────────────────
// PRACTICE QUESTION BANKS
// Separate from exam tables (LearningRepository/Item) so explanations and
// difficulty metadata don't bloat the exam pipeline.
//
// Difficulty / score-band system
// ──────────────────────────────
// Each question carries score_band_min / score_band_max that map to the
// student's current TOEIC score.  A student scoring 550 only sees questions
// in bands like 450-650.  difficulty_score (0.0–1.0) is a heuristic computed
// at import time from:
//   1. Vocabulary rarity  (high-frequency words → easier)
//   2. Option proximity   (very similar distractors → harder)
//   3. Part / section     (Part 7 RC harder than Part 5 for most learners)
//   4. Statistical update (fraction of students who answer correctly, later)
// ─────────────────────────────────────────────────────────────────────────────

/// TOEIC practice questions — study bank with AI explanations and difficulty.
/// AI runs in background: sets ai_explanation + ai_explained_at per question.
/// When a student reviews their answer the UI shows ai_explanation directly
/// from DB (no file I/O, no regeneration if already explained).
model ToeicPracticeQuestion {
  id Int @id @default(autoincrement())

  // Classification
  skill_area String @db.VarChar(30) // listening | reading | grammar | vocabulary
  part       Int? // TOEIC part number 1-7 (null for vocab/grammar)

  // Content
  stem            String // question text
  reading_passage String? // optional inline passage (Part 6-7 style)
  context_image   String? // image URL for Part 1 questions
  context_audio   String? // audio URL for Listening questions

  // Difficulty & score band
  // score_band maps to the student's current TOEIC score (5-990).
  // Questions are served when student_score ∈ [score_band_min-50, score_band_max+50].
  score_band_min   Int    @default(300) // e.g. 450 → for students ~400-550
  score_band_max   Int    @default(990) // e.g. 650 → question ceiling
  difficulty_label String @default("medium") @db.VarChar(20) // easy | medium | hard | expert
  difficulty_score Float? @db.DoublePrecision // 0.0 (trivial) → 1.0 (very hard)

  // Explanations
  explanation     String? // human-authored baseline explanation
  ai_explanation  String? // Ollama-generated; populated by background job
  ai_explained_at DateTime? @db.Timestamptz(6) // null = not yet explained; non-null = skip
  ai_model        String?   @db.VarChar(100) // model that generated the explanation

  // Source tracking (for provenance and dedup)
  source_slug    String? @db.VarChar(120) // LearningRepository.slug this was copied from
  source_item_id Int? // LearningRepositoryItem.id (nullable FK)

  is_published Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  options ToeicPracticeOption[]

  // Index for difficulty-filtered queries: "give me medium reading questions for score ~600"
  @@index([skill_area, score_band_min, score_band_max, is_published])
  // Background AI job scans for rows where ai_explained_at IS NULL
  @@index([ai_explained_at])
  @@map("ToeicPracticeQuestion")
}

model ToeicPracticeOption {
  id          Int     @id @default(autoincrement())
  question_id Int
  option_key  String  @db.VarChar(10) // A | B | C | D
  option_text String
  is_correct  Boolean @default(false)
  rationale   String? // why this option is right/wrong (optional)
  sort_order  Int     @default(0)

  question ToeicPracticeQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([question_id, option_key])
  @@index([question_id, sort_order])
  @@map("ToeicPracticeOption")
}

/// IELTS practice questions — band-based difficulty (bands 1–9).
model IeltsPracticeQuestion {
  id Int @id @default(autoincrement())

  skill_area    String  @db.VarChar(30) // listening | reading | writing | speaking
  question_type String? @db.VarChar(50) // mcq | fill-blank | matching | true-false | short-answer

  stem            String
  reading_passage String?
  context_audio   String?

  // Difficulty — IELTS band scale 1.0–9.0
  band_min         Float  @default(4.0) @db.DoublePrecision // e.g. 5.0
  band_max         Float  @default(9.0) @db.DoublePrecision // e.g. 6.5
  difficulty_label String @default("medium") @db.VarChar(20)
  difficulty_score Float? @db.DoublePrecision // 0.0–1.0

  explanation     String?
  ai_explanation  String?
  ai_explained_at DateTime? @db.Timestamptz(6)
  ai_model        String?   @db.VarChar(100)

  source_slug    String? @db.VarChar(120)
  source_item_id Int?

  is_published Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  options IeltsPracticeOption[]

  @@index([skill_area, band_min, band_max, is_published])
  @@index([ai_explained_at])
  @@map("IeltsPracticeQuestion")
}

model IeltsPracticeOption {
  id          Int     @id @default(autoincrement())
  question_id Int
  option_key  String  @db.VarChar(10)
  option_text String
  is_correct  Boolean @default(false)
  rationale   String?
  sort_order  Int     @default(0)

  question IeltsPracticeQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([question_id, option_key])
  @@index([question_id, sort_order])
  @@map("IeltsPracticeOption")
}

/// MOS (Microsoft Office Specialist) practice questions — score 1–1000.
model MosPracticeQuestion {
  id Int @id @default(autoincrement())

  app        String  @db.VarChar(30) // word | excel | powerpoint
  skill_area String? @db.VarChar(80) // e.g. "formatting" | "formulas" | "charts" | "mail-merge"

  stem            String
  reading_passage String? // scenario / task description shown to student

  // MOS score range 1–1000
  score_band_min   Int    @default(1)
  score_band_max   Int    @default(1000)
  difficulty_label String @default("medium") @db.VarChar(20) // easy | medium | hard | expert
  difficulty_score Float? @db.DoublePrecision

  explanation     String?
  ai_explanation  String?
  ai_explained_at DateTime? @db.Timestamptz(6)
  ai_model        String?   @db.VarChar(100)

  source_slug    String? @db.VarChar(120)
  source_item_id Int?

  is_published Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  options MosPracticeOption[]

  @@index([app, score_band_min, score_band_max, is_published])
  @@index([ai_explained_at])
  @@map("MosPracticeQuestion")
}

model MosPracticeOption {
  id          Int     @id @default(autoincrement())
  question_id Int
  option_key  String  @db.VarChar(10)
  option_text String
  is_correct  Boolean @default(false)
  rationale   String?
  sort_order  Int     @default(0)

  question MosPracticeQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([question_id, option_key])
  @@index([question_id, sort_order])
  @@map("MosPracticeOption")
}

/// Tracks which individual topics a student has completed within an enrollment.
/// topic_key uses a stable dot-notation key, e.g. 'grammar.basic_tenses'.
model CertificateTopicProgress {
  id            Int      @id @default(autoincrement())
  enrollment_id Int
  topic_key     String   @db.VarChar(100) // e.g. 'grammar.basic_tenses', 'listening.part1_form_fill'
  completed_at  DateTime @default(now()) @db.Timestamptz(6)

  enrollment CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@unique([enrollment_id, topic_key])
  @@index([enrollment_id])
  @@map("CertificateTopicProgress")
}

model Room {
  room_id Int    @id @default(autoincrement())
  host_id Int?
  title   String @db.VarChar(255)

  room_mode     String  @db.VarChar(20) // audio | video | focus
  password_hash String? @db.VarChar(255)

  cover_type String? @db.VarChar(20) // image | youtube
  cover_url  String? @db.VarChar(500)

  is_public        Boolean @default(true)
  max_participants Int     @default(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // relations
  host          Account?          @relation("RoomHost", fields: [host_id], references: [account_id])
  participants  RoomParticipant[]
  actions       RoomAction[]
  bans          RoomBan[]
  studySessions StudySession[]

  @@index([room_mode])
  @@index([is_public])
  @@map("Room")
}

model RoomParticipant {
  id Int @id @default(autoincrement())

  room_id    Int
  account_id Int

  is_host Boolean @default(false)

  camera_on Boolean @default(false)
  mic_on    Boolean @default(false)

  joined_at DateTime  @default(now()) @db.Timestamptz(6)
  left_at   DateTime? @db.Timestamptz(6)

  // relations
  room    Room    @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  account Account @relation(fields: [account_id], references: [account_id])

  @@index([room_id])
  @@index([account_id])
  @@index([room_id, left_at])
  @@map("RoomParticipant")
}

model RoomAction {
  id Int @id @default(autoincrement())

  room_id           Int
  target_account_id Int

  action_type String @db.VarChar(20) // kick | mute

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // relations
  room          Room    @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  targetAccount Account @relation("RoomActionTarget", fields: [target_account_id], references: [account_id])

  @@map("RoomAction")
}

model RoomBan {
  id Int @id @default(autoincrement())

  room_id    Int
  account_id Int

  banned_until DateTime? @db.Timestamptz(6)

  // relations
  room    Room    @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  account Account @relation(fields: [account_id], references: [account_id])

  @@map("RoomBan")
}

model StudySession {
  id Int @id @default(autoincrement())

  account_id Int
  room_id    Int?

  started_at DateTime  @db.Timestamptz(6)
  ended_at   DateTime? @db.Timestamptz(6)

  duration_minutes Int?

  // relations
  account Account @relation(fields: [account_id], references: [account_id])
  room    Room?   @relation(fields: [room_id], references: [room_id], onDelete: SetNull)

  @@index([account_id])
  @@index([started_at])
  @@index([account_id, ended_at]) // For migration and historical queries
  @@map("StudySession")
}

model DailyStreak {
  account_id Int @id

  current_streak Int @default(0)
  longest_streak Int @default(0)

  last_study_date DateTime? @db.Date

  // relation
  account Account @relation(fields: [account_id], references: [account_id])

  @@index([last_study_date]) // For streak queries
  @@map("DailyStreak")
}

model StudyStat {
  account_id Int @id

  total_minutes  Int @default(0)
  total_sessions Int @default(0)

  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // relation
  account Account @relation(fields: [account_id], references: [account_id])

  @@index([total_minutes(sort: Desc)]) // For total ranking queries
  @@map("StudyStat")
}

model Leaderboard {
  account_id Int @id

  score Int?
  rank  Int?

  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // relation
  account Account @relation(fields: [account_id], references: [account_id])

  @@map("Leaderboard")
}

// ─────────────────────────────────────────────────────────────────────────────
// VOCABULARY SYSTEM MODELS (TOEIC & IELTS)
// ─────────────────────────────────────────────────────────────────────────────

/// Chủ đề từ vựng TOEIC (Business, Office, Finance...)
model VocabTopic {
  id         Int      @id @default(autoincrement())
  slug       String   @unique @db.VarChar(100) // "email-van-phong"
  title_vi   String   @db.VarChar(200) // "Email & Văn phòng"
  title_en   String   @db.VarChar(200) // "Email & Office Communication"
  emoji      String   @db.VarChar(10) // "📧"
  cert_type  String   @default("toeic") @db.VarChar(20) // toeic | ielts
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  words VocabWord[]

  @@map("VocabTopic")
}

/// Từ vựng trong một chủ đề
model VocabWord {
  id         Int      @id @default(autoincrement())
  topic_id   Int
  word       String   @db.VarChar(200)
  level      String   @db.VarChar(20) // "Cơ bản" | "Trung bình" | "Nâng cao"
  freq       Int      @db.SmallInt // 1=thấp | 2=trung bình | 3=cao
  audio_url  String?  @db.VarChar(500) // TTS pre-generated URL (optional)
  source     String?  @db.VarChar(50) // "ocr-upload" | "manual" | "ai-generated"
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  topic       VocabTopic          @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  definitions VocabDefinition[]
  progress    UserVocabProgress[]

  @@unique([topic_id, word])
  @@index([topic_id])
  @@map("VocabWord")
}

/// Nhiều nghĩa/loại từ của một từ vựng
model VocabDefinition {
  id         Int    @id @default(autoincrement())
  word_id    Int
  pos        String @db.VarChar(20) // "n." | "v." | "adj." | "adv." | "prep."
  meaning    String @db.VarChar(500) // nghĩa tiếng Việt
  example_en String @db.Text // ví dụ tiếng Anh (có thể có <strong>)
  example_vi String @db.Text // dịch ví dụ
  sort_order Int    @default(0)

  word VocabWord @relation(fields: [word_id], references: [id], onDelete: Cascade)

  @@index([word_id])
  @@map("VocabDefinition")
}

/// Tiến độ học từ vựng của từng sinh viên
model UserVocabProgress {
  id             Int       @id @default(autoincrement())
  enrollment_id  Int // → CertificateEnrollment.id
  word_id        Int
  is_known       Boolean   @default(false)
  reviewed_at    DateTime? @db.Timestamptz(6)
  correct_streak Int       @default(0) // đúng liên tiếp trong bộ kiểm tra
  total_attempts Int       @default(0)
  total_correct  Int       @default(0)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)

  word       VocabWord             @relation(fields: [word_id], references: [id], onDelete: Cascade)
  enrollment CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@unique([enrollment_id, word_id])
  @@index([enrollment_id])
  @@map("UserVocabProgress")
}

/// Log lịch sử một phiên kiểm tra từ vựng
model VocabTestSession {
  id            Int       @id @default(autoincrement())
  enrollment_id Int
  mode          String    @db.VarChar(20) // "flashcard" | "write"
  word_ids      Json // int[] - danh sách từ được kiểm tra
  score         Int? // % đúng cuối phiên
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  ended_at      DateTime? @db.Timestamptz(6)

  enrollment CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  answers    VocabTestAnswer[]

  @@index([enrollment_id])
  @@map("VocabTestSession")
}

/// Đáp án từng từ trong phiên kiểm tra
model VocabTestAnswer {
  id          Int     @id @default(autoincrement())
  session_id  Int
  word_id     Int
  user_input  String? @db.Text // null nếu mode = flashcard
  is_correct  Boolean
  ai_score    Float? // 0.0 - 1.0 (Qwen2.5 fuzzy match)
  ai_feedback String? @db.Text

  session VocabTestSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("VocabTestAnswer")
}
