generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  account_id                 Int                             @id @default(autoincrement())
  email                      String                          @unique @db.VarChar(255)
  password_hash              String
  status                     String?                         @default("active") @db.VarChar(20)
  created_at                 DateTime                        @default(now()) @db.Timestamptz(6)
  last_login_at              DateTime?                       @db.Timestamptz(6)
  last_logout_at             DateTime?                       @db.Timestamptz(6)
  role_id                    Int?
  updated_at                 DateTime                        @default(now()) @db.Timestamptz(6)
  roleRel                    Role?                           @relation(fields: [role_id], references: [id])
  appointmentsBooked         Appointment[]
  verificationAttempts       AttendanceVerificationAttempt[]
  approvedAttempts           AttendanceVerificationAttempt[] @relation("AttendanceApprover")
  dailyStreak                DailyStreak?
  deviceFingerprints         DeviceFingerprint[]
  instructor                 Instructor?
  leaderboard                Leaderboard?
  notifications              Notification[]
  notificationMastersCreated NotificationMaster[]            @relation("NotificationMasterCreator")
  notificationRecipients     NotificationRecipient[]
  otps                       Otp[]
  parent                     Parent?
  profile                    Profile?
  reminderSchedules          ReminderSchedule[]
  hostedRooms                Room[]                          @relation("RoomHost")
  roomActions                RoomAction[]                    @relation("RoomActionTarget")
  roomBans                   RoomBan[]
  roomParticipants           RoomParticipant[]
  student                    Student?
  studySessions              StudySession[]
  studyStat                  StudyStat?
  createdSurveys             Survey[]                        @relation("AccountCreatedSurveys")
  surveyResponses            SurveyResponse[]
  prismaplacements           IeltsPlacementSession[]
  toeicExamSessions          ToeicExamSession[]
  activityLogs               UserActivityLog[]
  dailyActivitySummaries     UserDailyActivitySummary[]

  @@map("Account")
}

model Profile {
  profile_id    Int       @id @default(autoincrement())
  account_id    Int       @unique
  full_name     String    @db.VarChar(150)
  phone_number  String?   @db.VarChar(30)
  date_of_birth DateTime? @db.Date
  gender        String?   @db.VarChar(16)
  address       String?
  avatar_url    String?
  nationality   String?   @db.VarChar(80)
  account       Account   @relation(fields: [account_id], references: [account_id], onDelete: Cascade)

  @@map("Profile")
}

model Parent {
  parent_id          Int                 @id @default(autoincrement())
  account_id         Int                 @unique
  relationship_type  String?             @db.VarChar(32)
  occupation         String?             @db.VarChar(120)
  workplace          String?             @db.VarChar(255)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  account            Account             @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  parentStudentLinks ParentStudentLink[]

  @@map("Parent")
}

model Student {
  student_id             Int                     @id @default(autoincrement())
  account_id             Int                     @unique
  student_code           String                  @unique @db.VarChar(50)
  major                  String?                 @db.VarChar(120)
  cohort_year            Int?
  class_id               Int?
  status                 String?                 @default("active") @db.VarChar(20)
  appointments           Appointment[]
  attendanceSessions     AttendanceSession[]
  certificateEnrollments CertificateEnrollment[]
  parentStudentLinks     ParentStudentLink[]
  predictionResults      PredictionResult[]
  account                Account                 @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  classGroup             ClassGroup?             @relation(fields: [class_id], references: [class_id])
  courseRecords          StudentCourseRecord[]
  surveyFactors          StudentSurveyFactors?

  // Analytics relations
  testResults            StudentTestResult[]
  learningProgress       StudentLearningProgress[]

  @@map("Student")
}

model Instructor {
  instructor_id               Int                          @id @default(autoincrement())
  account_id                  Int                          @unique
  employee_code               String                       @unique @db.VarChar(50)
  academic_title              String?                      @db.VarChar(100)
  position                    String?                      @db.VarChar(100)
  department_id               Int?
  hire_date                   DateTime?                    @db.Date
  status                      String?                      @default("active") @db.VarChar(20)
  adviserAssignments          AdviserAssignment[]
  appointments                Appointment[]
  attendanceSessions          AttendanceSession[]
  account                     Account                      @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  department                  Department?                  @relation(fields: [department_id], references: [department_id])
  instructorAvailabilityWeeks InstructorAvailabilityWeek[]
  predictionResults           PredictionResult[]

  @@map("Instructor")
}

model Department {
  department_id Int          @id @default(autoincrement())
  code          String?      @unique @db.VarChar(20)
  name          String       @db.VarChar(150)
  status        String?      @default("active") @db.VarChar(20)
  instructors   Instructor[]
  programs      Program[]

  @@map("Department")
}

model Program {
  program_id        Int                @id @default(autoincrement())
  program_code      String             @unique @db.VarChar(20)
  program_name      String             @db.VarChar(255)
  duration_years    Int?               @default(4) @db.SmallInt
  department_id     Int
  classGroups       ClassGroup[]
  curriculumCourses CurriculumCourse[]
  department        Department         @relation(fields: [department_id], references: [department_id])

  @@map("Program")
}

model ClassGroup {
  class_id           Int                 @id @default(autoincrement())
  class_code         String              @unique @db.VarChar(30)
  program_id         Int?
  cohort_year        Int
  status             String?             @default("active") @db.VarChar(20)
  adviserAssignments AdviserAssignment[]
  program            Program?            @relation(fields: [program_id], references: [program_id])
  students           Student[]

  @@map("ClassGroup")
}

model AdviserAssignment {
  adviser_assign_id Int        @id @default(autoincrement())
  class_id          Int
  instructor_id     Int
  assigned_date     DateTime?  @db.Date
  ended_date        DateTime?  @db.Date
  note              String?
  classGroup        ClassGroup @relation(fields: [class_id], references: [class_id], onDelete: Cascade)
  instructor        Instructor @relation(fields: [instructor_id], references: [instructor_id], onDelete: Cascade)

  @@unique([class_id, instructor_id])
  @@map("AdviserAssignment")
}

model ParentStudentLink {
  link_id    Int      @id @default(autoincrement())
  parent_id  Int?
  student_id Int
  link_code  String?  @unique @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  parent     Parent?  @relation(fields: [parent_id], references: [parent_id], onDelete: Cascade)
  student    Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@unique([parent_id, student_id])
  @@map("ParentStudentLink")
}

model AcademicTerm {
  term_id              Int                   @id @default(autoincrement())
  academic_year        String                @db.VarChar(20)
  semester_number      Int                   @db.SmallInt
  is_summer            Boolean               @default(false)
  status               String?               @default("active") @db.VarChar(20)
  predictionResults    PredictionResult[]
  studentCourseRecords StudentCourseRecord[]

  @@unique([academic_year, semester_number])
  @@map("AcademicTerm")
}

model Course {
  course_id            Int                   @id @default(autoincrement())
  course_code          String                @db.VarChar(20)
  course_name          String                @db.VarChar(255)
  credits_unit         Int?                  @db.SmallInt
  study_format         String?               @default("offline") @db.VarChar(20)
  language             String?               @db.VarChar(30)
  difficulty           String?               @db.VarChar(20)
  description          String?
  curriculumCourses    CurriculumCourse[]
  predictionResults    PredictionResult[]
  studentCourseRecords StudentCourseRecord[]

  @@unique([course_code, study_format])
  @@map("Course")
}

model CurriculumCourse {
  id           Int     @id @default(autoincrement())
  program_id   Int
  course_id    Int
  year_number  Int     @db.SmallInt
  term_number  Int     @db.SmallInt
  is_mandatory Boolean @default(true)
  note         String?
  course       Course  @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  program      Program @relation(fields: [program_id], references: [program_id], onDelete: Cascade)

  @@unique([program_id, course_id])
  @@map("CurriculumCourse")
}

model StudentCourseRecord {
  record_id               Int           @id @default(autoincrement())
  student_id              Int?
  course_id               Int?
  term_id                 Int?
  status                  String?       @default("planned") @db.VarChar(20)
  raw_score               Decimal?      @db.Decimal(5, 2)
  converted_score         String?       @db.VarChar(5)
  converted_numeric_score Decimal?      @db.Decimal(5, 2)
  course                  Course?       @relation(fields: [course_id], references: [course_id])
  student                 Student?      @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  academicTerm            AcademicTerm? @relation(fields: [term_id], references: [term_id])

  @@unique([student_id, course_id])
  @@map("StudentCourseRecord")
}

model SurveyQuestion {
  question_id   Int                  @id @default(autoincrement())
  question_text String
  question_type String?              @db.VarChar(20)
  category      String?              @db.VarChar(50)
  is_active     Boolean              @default(true)
  code          String?              @unique @db.VarChar(100)
  min_value     Float?
  max_value     Float?
  surveyAnswers SurveyAnswer[]
  surveyOptions SurveyOption[]
  questionLinks SurveyQuestionLink[]

  @@map("SurveyQuestion")
}

model SurveyOption {
  option_id     Int             @id @default(autoincrement())
  question_id   Int?
  option_text   String?
  option_value  Int?
  surveyAnswers SurveyAnswer[]
  question      SurveyQuestion? @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@map("SurveyOption")
}

model SurveyResponse {
  response_id   Int            @id @default(autoincrement())
  account_id    Int?
  survey_id     Int?
  submitted_at  DateTime       @default(now()) @db.Timestamptz(6)
  surveyAnswers SurveyAnswer[]
  account       Account?       @relation(fields: [account_id], references: [account_id])
  survey        Survey?        @relation(fields: [survey_id], references: [survey_id], onDelete: Cascade)

  @@map("SurveyResponse")
}

model SurveyAnswer {
  answer_id   Int             @id @default(autoincrement())
  response_id Int?
  question_id Int?
  option_id   Int?
  free_text   String?
  option      SurveyOption?   @relation(fields: [option_id], references: [option_id])
  question    SurveyQuestion? @relation(fields: [question_id], references: [question_id], onDelete: Cascade)
  response    SurveyResponse? @relation(fields: [response_id], references: [response_id], onDelete: Cascade)

  @@map("SurveyAnswer")
}

model Survey {
  survey_id       Int                  @id @default(autoincrement())
  title           String
  description     String?
  created_by      Int?
  created_at      DateTime             @default(now()) @db.Timestamptz(6)
  start_date      DateTime?            @db.Timestamptz(6)
  end_date        DateTime?            @db.Timestamptz(6)
  is_active       Boolean              @default(true)
  type            String?              @db.VarChar(30)
  target_role     String?              @db.VarChar(20)
  createdBy       Account?             @relation("AccountCreatedSurveys", fields: [created_by], references: [account_id])
  surveyQuestions SurveyQuestionLink[]
  surveyResponses SurveyResponse[]

  @@map("Survey")
}

model SurveyQuestionLink {
  id          Int            @id @default(autoincrement())
  survey_id   Int
  question_id Int
  order_index Int?
  question    SurveyQuestion @relation(fields: [question_id], references: [question_id], onDelete: Cascade)
  survey      Survey         @relation(fields: [survey_id], references: [survey_id], onDelete: Cascade)

  @@unique([survey_id, question_id])
  @@map("SurveyQuestionLink")
}

model InstructorAvailabilityWeek {
  week_id                     Int                          @id @default(autoincrement())
  instructor_id               Int?
  week_start_date             DateTime                     @db.Date
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  instructorAvailabilityDates InstructorAvailabilityDate[]
  instructor                  Instructor?                  @relation(fields: [instructor_id], references: [instructor_id], onDelete: Cascade)

  @@unique([instructor_id, week_start_date])
  @@map("InstructorAvailabilityWeek")
}

model InstructorAvailabilityDate {
  date_id       Int                        @id @default(autoincrement())
  week_id       Int
  specific_date DateTime                   @db.Date
  is_available  Boolean                    @default(true)
  note          String?
  created_at    DateTime                   @default(now()) @db.Timestamptz(6)
  week          InstructorAvailabilityWeek @relation(fields: [week_id], references: [week_id], onDelete: Cascade)
  slots         InstructorDailySlot[]

  @@unique([week_id, specific_date])
  @@map("InstructorAvailabilityDate")
}

model InstructorDailySlot {
  slot_id          Int                        @id @default(autoincrement())
  date_id          Int
  start_time_local DateTime?                  @db.Time(6)
  end_time_local   DateTime?                  @db.Time(6)
  period_label     String?                    @db.VarChar(16)
  capacity         Int                        @default(10) @db.SmallInt
  is_open          Boolean                    @default(true)
  note             String?
  auto_accept      Boolean                    @default(false)
  meeting_link     String?
  meeting_location String?
  meeting_type     MeetingType?               @default(offline)
  appointments     Appointment[]
  date             InstructorAvailabilityDate @relation(fields: [date_id], references: [date_id], onDelete: Cascade)

  @@unique([date_id, start_time_local])
  @@map("InstructorDailySlot")
}

model Appointment {
  appointment_id        Int                 @id @default(autoincrement())
  slot_id               Int
  booker_account_id     Int
  booker_role           String              @db.VarChar(20)
  student_id            Int?
  instructor_id         Int?
  meeting_purpose       String?             @db.VarChar(255)
  status                String              @default("pending") @db.VarChar(32)
  cancel_reason         String?
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?           @db.Timestamptz(6)
  canceled_at           DateTime?           @db.Timestamptz(6)
  attendance_checked_at DateTime?           @db.Timestamptz(6)
  attendance_status     String?             @db.VarChar(20)
  attended              Boolean?
  meeting_type          MeetingType
  booker                Account             @relation(fields: [booker_account_id], references: [account_id])
  instructor            Instructor?         @relation(fields: [instructor_id], references: [instructor_id])
  slot                  InstructorDailySlot @relation(fields: [slot_id], references: [slot_id], onDelete: Cascade)
  student               Student?            @relation(fields: [student_id], references: [student_id])
  appointmentContact    AppointmentContact?
  attendanceSessions    AttendanceSession[]
  reminderSchedules     ReminderSchedule[]

  @@map("Appointment")
}

model AppointmentContact {
  appointment_id          Int         @id
  contact_name            String?     @db.VarChar(150)
  contact_phone           String?     @db.VarChar(30)
  contact_email           String?     @db.VarChar(255)
  relationship_to_student String?     @db.VarChar(64)
  appointment             Appointment @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade)

  @@map("AppointmentContact")
}

model NotificationTemplate {
  template_id         Int                  @id @default(autoincrement())
  code                String               @unique @db.VarChar(120)
  title               String?              @db.VarChar(255)
  content             String
  channel             String?              @db.VarChar(20)
  is_active           Boolean              @default(true)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime             @updatedAt @db.Timestamptz(6)
  notifications       Notification[]
  notificationMasters NotificationMaster[]
  reminderSchedules   ReminderSchedule[]

  @@map("NotificationTemplate")
}

model NotificationMaster {
  id          Int                     @id @default(autoincrement())
  title       String                  @db.VarChar(255)
  body        String
  type        String?                 @db.VarChar(100)
  priority    String?                 @db.VarChar(20)
  target      String?                 @db.VarChar(100)
  channel     String?                 @db.VarChar(20)
  attachments Json?
  created_by  Int
  created_at  DateTime                @default(now()) @db.Timestamptz(6)
  template_id Int?
  creator     Account                 @relation("NotificationMasterCreator", fields: [created_by], references: [account_id], onDelete: Cascade)
  template    NotificationTemplate?   @relation(fields: [template_id], references: [template_id])
  recipients  NotificationRecipient[]

  @@map("NotificationMaster")
}

model NotificationRecipient {
  id           Int                @id @default(autoincrement())
  master_id    Int
  account_id   Int
  is_read      Boolean            @default(false)
  read_at      DateTime?          @db.Timestamptz(6)
  delivered_at DateTime?          @db.Timestamptz(6)
  account      Account            @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  master       NotificationMaster @relation(fields: [master_id], references: [id], onDelete: Cascade)

  @@unique([master_id, account_id])
  @@index([account_id])
  @@index([master_id])
  @@map("NotificationRecipient")
}

model Notification {
  notification_id Int                   @id @default(autoincrement())
  account_id      Int
  title           String                @db.VarChar(255)
  body            String
  type            String?               @db.VarChar(50)
  priority        String?               @db.VarChar(20)
  attachments     Json?
  is_read         Boolean               @default(false)
  created_at      DateTime              @default(now()) @db.Timestamptz(6)
  template_id     Int?
  account         Account               @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  template        NotificationTemplate? @relation(fields: [template_id], references: [template_id])

  @@map("Notification")
}

model NotificationDraft {
  draft_id    Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  content     String
  type        String   @db.VarChar(100)
  target      String   @db.VarChar(100)
  priority    String   @db.VarChar(20)
  attachments Json?
  created_by  Int?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@map("NotificationDraft")
}

model NotificationHistory {
  history_id       Int      @id @default(autoincrement())
  action           String   @db.VarChar(20)
  title            String   @db.VarChar(255)
  content          String
  type             String   @db.VarChar(100)
  target           String   @db.VarChar(100)
  priority         String   @db.VarChar(20)
  attachments      Json?
  total_recipients Int      @default(0)
  read_count       Int      @default(0)
  action_date      DateTime @default(now()) @db.Timestamptz(6)
  created_date     DateTime @db.Timestamptz(6)
  master_id        Int?

  @@map("NotificationHistory")
}

model ReminderSchedule {
  reminder_id    Int                  @id @default(autoincrement())
  appointment_id Int?
  account_id     Int
  recipient_role RecipientRole        @default(booker)
  template_code  String               @db.VarChar(120)
  remind_at      DateTime             @db.Timestamptz(6)
  sent_at        DateTime?            @db.Timestamptz(6)
  channel        String?              @db.VarChar(32)
  metadata       Json?
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  canceled       Boolean              @default(false)
  account        Account              @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  appointment    Appointment?         @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade)
  template       NotificationTemplate @relation(fields: [template_code], references: [code], onDelete: SetNull)

  @@unique([appointment_id, account_id, remind_at, template_code, recipient_role])
  @@index([remind_at, sent_at])
  @@map("ReminderSchedule")
}

/// OTPs for account verification / password reset
model Otp {
  otp_id     Int      @id @default(autoincrement())
  account_id Int
  code       String   @db.VarChar(10)
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  account    Account  @relation(fields: [account_id], references: [account_id], onDelete: Cascade)

  @@index([account_id])
  @@map("Otp")
}

/// Role-based permissions persisted for roles (admin-managed)
model Role {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(150)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  accounts        Account[]
  rolePermissions RolePermission[]

  @@map("Role")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique @db.VarChar(200)
  name            String           @db.VarChar(200)
  category        String?          @db.VarChar(120)
  description     String?
  sensitive       Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("Permission")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  enabled      Boolean    @default(false)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("RolePermission")
}

model EventLog {
  id                    Int       @id @default(autoincrement())
  table_name            String
  operation             String
  record_id             Int?
  payload               Json?
  created_at            DateTime  @default(now())
  processed             Boolean   @default(false)
  processed_at          DateTime? @db.Timestamptz(6)
  processing            Boolean   @default(false)
  processing_by         String?
  processing_started_at DateTime? @db.Timestamptz(6)
  retry_count           Int       @default(0)
  last_error            String?
  failed                Boolean   @default(false)

  @@index([failed, processed, processing, created_at(sort: Desc)], map: "idx_eventlog_unprocessed")
  @@index([table_name, created_at(sort: Desc)], map: "idx_eventlog_table_created_at")
  @@map("EventLog")
}

model PredictionResult {
  prediction_id          Int           @id @default(autoincrement())
  student_id             Int
  course_id              Int
  instructor_id          Int?
  model_type             String        @db.VarChar(20)
  predicted_gpa          Decimal?      @db.Decimal(5, 2)
  predicted_fail_warning Boolean?
  prediction_confidence  Float?
  model_version          String        @db.VarChar(50)
  input_source           String?       @db.VarChar(50)
  enriched_for_student   Boolean       @default(false)
  prediction_status      String        @default("active") @db.VarChar(20)
  term_id                Int?
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @updatedAt @db.Timestamptz(6)
  course                 Course        @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  instructor             Instructor?   @relation(fields: [instructor_id], references: [instructor_id])
  student                Student       @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  academicTerm           AcademicTerm? @relation(fields: [term_id], references: [term_id])

  @@unique([student_id, course_id, model_type, model_version])
  @@map("PredictionResult")
}

model StudentSurveyFactors {
  factor_id               Int      @id @default(autoincrement())
  student_id              Int      @unique
  study_time_hours        Float?
  work_time_hours         Float?
  financial_support_score Float?
  mental_health_score     Float?
  updated_at              DateTime @updatedAt @db.Timestamptz(6)
  student                 Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("StudentSurveyFactors")
}

model AttendanceSession {
  session_id           String                          @id @default(cuid())
  appointment_id       Int?
  instructor_id        Int
  student_id           Int?
  started_at           DateTime                        @default(now()) @db.Timestamptz(6)
  ended_at             DateTime?                       @db.Timestamptz(6)
  status               String                          @default("active") @db.VarChar(20)
  qr_refresh_interval  Int                             @default(3000)
  qr_expiry_seconds    Int                             @default(15)
  created_at           DateTime                        @default(now()) @db.Timestamptz(6)
  appointment          Appointment?                    @relation(fields: [appointment_id], references: [appointment_id], onDelete: Cascade)
  instructor           Instructor                      @relation(fields: [instructor_id], references: [instructor_id])
  student              Student?                        @relation(fields: [student_id], references: [student_id])
  verificationAttempts AttendanceVerificationAttempt[]

  @@map("AttendanceSession")
}

model AttendanceVerificationAttempt {
  attempt_id              Int               @id @default(autoincrement())
  session_id              String
  account_id              Int
  timestamp               DateTime          @default(now()) @db.Timestamptz(6)
  qr_token                String?           @db.VarChar(255)
  qr_valid                Boolean           @default(false)
  qr_fresh                Boolean           @default(false)
  qr_not_reused           Boolean           @default(false)
  device_fingerprint      String?           @db.VarChar(500)
  device_match            Boolean           @default(false)
  device_changed_recently Boolean           @default(false)
  client_ip               String?           @db.VarChar(45)
  campus_ip               Boolean           @default(false)
  wifi_ssid               String?           @db.VarChar(100)
  campus_wifi             Boolean           @default(false)
  network_latency         Int?
  gps_latitude            Float?
  gps_longitude           Float?
  gps_accuracy            Float?
  gps_timestamp           DateTime?
  campus_zone             Boolean           @default(false)
  gps_spoof_detected      Boolean           @default(false)
  scan_duration           Int?
  typing_pattern          String?           @db.VarChar(500)
  behavior_normal         Boolean           @default(false)
  trust_score             Int               @default(0)
  risk_level              String            @default("high") @db.VarChar(20)
  approved                Boolean           @default(false)
  approved_by             Int?
  approved_at             DateTime?
  review_reason           String?           @db.VarChar(500)
  suspicious_timing       Boolean           @default(false)
  multiple_attempts       Boolean           @default(false)
  vpn_detected            Boolean           @default(false)
  brute_force_pattern     Boolean           @default(false)
  account                 Account           @relation(fields: [account_id], references: [account_id])
  approver                Account?          @relation("AttendanceApprover", fields: [approved_by], references: [account_id])
  session                 AttendanceSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id, timestamp])
  @@index([account_id, timestamp])
  @@map("AttendanceVerificationAttempt")
}

model DeviceFingerprint {
  fingerprint_id       String    @id @default(cuid())
  account_id           Int
  fingerprint_hash     String    @unique @db.VarChar(500)
  user_agent           String?   @db.VarChar(500)
  screen_resolution    String?   @db.VarChar(50)
  timezone             String?   @db.VarChar(100)
  language             String?   @db.VarChar(10)
  platform             String?   @db.VarChar(50)
  hardware_concurrency Int?
  device_memory        Float?
  canvas_fingerprint   String?   @db.VarChar(500)
  webgl_fingerprint    String?   @db.VarChar(500)
  is_primary           Boolean   @default(false)
  last_used_at         DateTime  @default(now()) @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  verified_at          DateTime?
  account              Account   @relation(fields: [account_id], references: [account_id], onDelete: Cascade)

  @@unique([account_id, fingerprint_hash])
  @@index([account_id, is_primary])
  @@map("DeviceFingerprint")
}

model CampusNetworkConfig {
  config_id        Int      @id @default(autoincrement())
  campus_name      String   @unique @db.VarChar(100)
  ip_ranges        String
  wifi_ssids       String
  gateway_ips      String
  gps_boundaries   String?
  latitude_center  Float?
  longitude_center Float?
  radius_meters    Int?     @default(200)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  @@map("CampusNetworkConfig")
}

/// Records which band/level a student has enrolled in for a given certificate.
/// Constraint: only ONE active enrollment per (student, cert_type) at a time.
/// To switch bands the student must complete the current band first.
model CertificateEnrollment {
  id                   Int                        @id @default(autoincrement())
  student_id           Int
  cert_type            String                     @db.VarChar(30)
  status               String                     @default("active") @db.VarChar(20)
  learning_status      String                     @default("not_started") @db.VarChar(20)
  progress_percent     Int                        @default(0) @db.SmallInt
  current_score        Int?
  target_score         Int?
  toeic_plan_state     Json?
  /// Accumulated practice reserve points (0–100).
  /// Reaching 100 unlocks the exam-simulation for the current score band.
  reserve_points       Float                      @default(0)
  started_at           DateTime?                  @db.Timestamptz(6)
  last_activity_at     DateTime?                  @db.Timestamptz(6)
  completed_at         DateTime?                  @db.Timestamptz(6)
  enrolled_at          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                   @updatedAt @db.Timestamptz(6)
  exam_score           Int?
  student              Student                    @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  topicProgress        CertificateTopicProgress[]
  ieltsRoadmap         IeltsAdaptiveRoadmap?
  recommendations      IeltsRecommendation[]
  weakPoints           IeltsWeakPoint[]
  practicePartSessions ToeicPracticePartSession[]
  userVocabProgress    UserVocabProgress[]
  vocabTestSessions    VocabTestSession[]

  // Analytics relations
  testResults          StudentTestResult[]
  learningProgress     StudentLearningProgress?

  @@index([student_id, cert_type, status])
  @@map("CertificateEnrollment")
}

/// Detailed content repository for certificate learning materials (question-bank style).
model LearningRepository {
  id                Int                      @id @default(autoincrement())
  cert_type         String                   @db.VarChar(30)
  title             String                   @db.VarChar(255)
  slug              String                   @unique @db.VarChar(120)
  description       String?
  content_type      String                   @default("practice_set") @db.VarChar(30)
  skill_area        String?                  @db.VarChar(50)
  topic_group       String?                  @db.VarChar(100)
  difficulty_level  String?                  @db.VarChar(20)
  target_score_min  Int?
  target_score_max  Int?
  estimated_minutes Int?
  pass_score        Int?
  tags              Json?
  metadata          Json?
  total_items       Int                      @default(0)
  is_published      Boolean                  @default(false)
  version           Int                      @default(1)
  created_by        Int?
  created_at        DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                 @updatedAt @db.Timestamptz(6)
  lessons_flashcard IeltsLesson[]            @relation("FlashcardRepo")
  lessons_minitest  IeltsLesson[]            @relation("MiniTestRepo")
  lessons_practice  IeltsLesson[]            @relation("PracticeRepo")
  items             LearningRepositoryItem[]

  @@index([cert_type, content_type, is_published])
  @@index([skill_area, topic_group])
  @@map("LearningRepository")
}

/// Individual learning item/question in a repository.
model LearningRepositoryItem {
  id                Int                        @id @default(autoincrement())
  repository_id     Int
  item_order        Int                        @default(1)
  item_type         String                     @default("single_choice") @db.VarChar(30)
  title             String?                    @db.VarChar(255)
  stem              String
  reading_passage   String?
  hint              String?
  explanation       String?
  ai_explanation    String?
  difficulty_level  String?                    @db.VarChar(20)
  score_weight      Int                        @default(1)
  estimated_seconds Int?
  media_audio_url   String?
  media_image_url   String?
  metadata          Json?
  created_at        DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at        DateTime                   @updatedAt @db.Timestamptz(6)
  repository        LearningRepository         @relation(fields: [repository_id], references: [id], onDelete: Cascade)
  options           LearningRepositoryOption[]

  @@unique([repository_id, item_order])
  @@index([repository_id])
  @@map("LearningRepositoryItem")
}

/// Options/answers for objective learning items.
model LearningRepositoryOption {
  id          Int                    @id @default(autoincrement())
  item_id     Int
  option_key  String                 @db.VarChar(10)
  option_text String
  is_correct  Boolean                @default(false)
  rationale   String?
  sort_order  Int                    @default(1)
  created_at  DateTime               @default(now()) @db.Timestamptz(6)
  item        LearningRepositoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([item_id, option_key])
  @@index([item_id, sort_order])
  @@map("LearningRepositoryOption")
}

/// DB cache for AI-generated explanations of hardcoded TOEIC practice questions.
/// Keyed by topic_key (e.g. "toeic.listening.node_0.q_1.full") — survives server restarts.
model ToeicNodeQuestionCache {
  id         Int      @id @default(autoincrement())
  topic_key  String   @unique @db.VarChar(220)
  cert_type  String   @db.VarChar(30)
  ai_answer  String
  model      String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([cert_type])
  @@map("ToeicNodeQuestionCache")
}

/// Tracks which individual topics a student has completed within an enrollment.
/// topic_key uses a stable dot-notation key, e.g. 'grammar.basic_tenses'.
model CertificateTopicProgress {
  id            Int                   @id @default(autoincrement())
  enrollment_id Int
  topic_key     String                @db.VarChar(100)
  completed_at  DateTime              @default(now()) @db.Timestamptz(6)
  enrollment    CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@unique([enrollment_id, topic_key])
  @@index([enrollment_id])
  @@map("CertificateTopicProgress")
}

model IeltsQuestion {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skill            String
  subSkillCode     String?                @map("sub_skill_code")
  questionType     String                 @map("question_type")
  questionText     String                 @map("question_text")
  options          Json?
  correctAnswer    String                 @map("correct_answer")
  explanation      String?
  keywords         String[]               @default([])
  bandMin          Decimal                @map("band_min") @db.Decimal(2, 1)
  bandMax          Decimal                @map("band_max") @db.Decimal(2, 1)
  difficultyWeight Decimal                @default(1.0) @map("difficulty_weight") @db.Decimal(3, 2)
  expectedTimeSec  Int                    @default(60) @map("expected_time_sec")
  errorTag         String?                @map("error_tag")
  topicTags        String[]               @default([]) @map("topic_tags")
  isAiGenerated    Boolean                @default(false) @map("is_ai_generated")
  aiModel          String?                @map("ai_model")
  seedQuestionIds  String[]               @default([]) @map("seed_question_ids") @db.Uuid
  status           String                 @default("draft")
  qualityScore     Int?                   @map("quality_score") @db.SmallInt
  usedCount        Int                    @default(0) @map("used_count")
  correctRate      Decimal?               @map("correct_rate") @db.Decimal(4, 3)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  irtA             Decimal?               @default(1.0) @map("irt_a") @db.Decimal(4, 3)
  irtB             Decimal?               @map("irt_b") @db.Decimal(4, 3)
  irtC             Decimal?               @map("irt_c") @db.Decimal(4, 3)
  isPlacement      Boolean?               @map("is_placement")
  passage_id       String?                @map("passage_id") @db.Uuid
  contextType      String?                @map("context_type")
  placementAnswers IeltsPlacementAnswer[] @relation("PlacementAnswers")
  passage          IeltsPassage?          @relation(fields: [passage_id], references: [id])

  @@index([skill, status], map: "idx_ielts_q_skill_status")
  @@index([bandMin, bandMax], map: "idx_ielts_q_band")
  @@index([errorTag], map: "idx_ielts_q_error_tag")
  @@map("ielts_questions")
}

model IeltsPassage {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skill            String
  title            String
  content          String
  band_min         Decimal         @db.Decimal(5, 2)
  band_max         Decimal         @db.Decimal(5, 2)
  topic_tags       String[]        @default([])
  section_type     Int?            @db.SmallInt
  section_number   Int?            @map("section_number") @db.SmallInt
  is_ai_generated  Boolean         @default(false)
  is_paraphrased   Boolean         @default(false)
  status           String          @default("draft")
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  audio_url        String?
  audio_duration_s Int?            @map("audio_duration_sec")
  accent_type      String?
  tts_generated    Boolean?
  questions        IeltsQuestion[]

  @@map("ielts_passages")
}

model IeltsPlacementSession {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId            Int                    @map("account_id")
  skillsTested         String[]               @map("skills_tested")
  status               PlacementStatus        @default(in_progress)
  currentEstimatedBand Decimal                @default(5.0) @map("current_estimated_band") @db.Decimal(2, 1)
  usedQuestionIds      String[]               @default([]) @map("used_question_ids") @db.Uuid
  totalQuestionsAsked  Int                    @default(0) @map("total_questions_asked")
  consecutiveCorrect   Int                    @default(0) @map("consecutive_correct")
  consecutiveWrong     Int                    @default(0) @map("consecutive_wrong")
  startedAt            DateTime               @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime?              @map("completed_at") @db.Timestamptz(6)
  finalBand            Decimal?               @map("final_band") @db.Decimal(2, 1)
  skillBands           Json?                  @map("skill_bands")
  confidenceLevel      ConfidenceLevel?       @map("confidence_level")
  skillsAnswered       Json                   @default("{}") @map("skills_answered")
  skillThetas          Json                   @default("{}") @map("skill_thetas")
  answers              IeltsPlacementAnswer[]
  user                 Account                @relation(fields: [accountId], references: [account_id], onDelete: Cascade)

  @@index([accountId, status], map: "idx_placement_account")
  @@map("ielts_placement_sessions")
}

model IeltsPlacementAnswer {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String                @map("session_id") @db.Uuid
  questionId       String                @map("question_id") @db.Uuid
  questionOrder    Int                   @map("question_order") @db.SmallInt
  bandAtTime       Decimal               @map("band_at_time") @db.Decimal(2, 1)
  bandMid          Decimal               @map("band_mid") @db.Decimal(2, 1)
  difficultyWeight Decimal               @map("difficulty_weight") @db.Decimal(3, 2)
  userAnswer       String?               @map("user_answer")
  isCorrect        Boolean?              @map("is_correct")
  timeTakenSec     Int?                  @map("time_taken_sec")
  answeredAt       DateTime              @default(now()) @map("answered_at") @db.Timestamptz(6)
  irtASnapshot     Decimal?              @map("irt_a_snapshot") @db.Decimal(5, 3)
  irtBSnapshot     Decimal?              @map("irt_b_snapshot") @db.Decimal(5, 3)
  irtCSnapshot     Decimal?              @map("irt_c_snapshot") @db.Decimal(5, 3)
  skill            String?
  question         IeltsQuestion         @relation("PlacementAnswers", fields: [questionId], references: [id])
  session          IeltsPlacementSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionOrder])
  @@index([sessionId, questionOrder], map: "idx_placement_answers_session")
  @@map("ielts_placement_answers")
}

model ToeicPracticePartSession {
  id              Int                   @id @default(autoincrement())
  enrollment_id   Int
  skill_area      String                @db.VarChar(20)
  toeic_part      Int                   @db.SmallInt
  /// Score band of questions served in this session (matches student's level).
  score_band_min  Int                   @default(0)
  score_band_max  Int                   @default(990)
  /// IDs of the ToeicPracticeQuestion rows that were served (ordered).
  question_ids    Json
  /// Student's submitted answers: { "<question_id>": "A" | "B" | "C" | "D" }
  answers         Json
  total_questions Int                   @default(10) @db.SmallInt
  correct_count   Int                   @default(0) @db.SmallInt
  /// Reserve points earned in this session (correct_count × points_per_correct for this part).
  earned_points   Float                 @default(0)
  completed_at    DateTime              @default(now()) @db.Timestamptz(6)
  created_at      DateTime              @default(now()) @db.Timestamptz(6)
  enrollment      CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@index([enrollment_id, skill_area, toeic_part])
  @@index([enrollment_id, completed_at])
  @@map("ToeicPracticePartSession")
}

model Room {
  room_id          Int               @id @default(autoincrement())
  host_id          Int?
  title            String            @db.VarChar(255)
  room_mode        String            @db.VarChar(20)
  password_hash    String?           @db.VarChar(255)
  cover_type       String?           @db.VarChar(20)
  cover_url        String?           @db.VarChar(500)
  is_public        Boolean           @default(true)
  max_participants Int               @default(6)
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  host             Account?          @relation("RoomHost", fields: [host_id], references: [account_id])
  actions          RoomAction[]
  bans             RoomBan[]
  participants     RoomParticipant[]
  studySessions    StudySession[]

  @@index([room_mode])
  @@index([is_public])
  @@map("Room")
}

model RoomParticipant {
  id         Int       @id @default(autoincrement())
  room_id    Int
  account_id Int
  is_host    Boolean   @default(false)
  camera_on  Boolean   @default(false)
  mic_on     Boolean   @default(false)
  joined_at  DateTime  @default(now()) @db.Timestamptz(6)
  left_at    DateTime? @db.Timestamptz(6)
  account    Account   @relation(fields: [account_id], references: [account_id])
  room       Room      @relation(fields: [room_id], references: [room_id], onDelete: Cascade)

  @@index([room_id])
  @@index([account_id])
  @@index([room_id, left_at])
  @@map("RoomParticipant")
}

model RoomAction {
  id                Int      @id @default(autoincrement())
  room_id           Int
  target_account_id Int
  action_type       String   @db.VarChar(20)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  room              Room     @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  targetAccount     Account  @relation("RoomActionTarget", fields: [target_account_id], references: [account_id])

  @@map("RoomAction")
}

model RoomBan {
  id           Int       @id @default(autoincrement())
  room_id      Int
  account_id   Int
  banned_until DateTime? @db.Timestamptz(6)
  account      Account   @relation(fields: [account_id], references: [account_id])
