  @@map("IeltsPracticeSession")
}

model IeltsBandTest {
  id                      String               @id @default(uuid())
  roadmap_id              Int
  test_name               String
  band_level              Float
  skills_tested           String[]
  question_ids            String[]
  answers                 Json                 @default("{}")
  total_questions         Int
  correct_count           Int
  accuracy_percent        Float
  total_time_sec          Int                  @default(0)
  expected_time_sec       Int
  response_time_factor    Float                @default(0)
  consistency_score       Float?
  severe_error_count      Int                  @default(0)
  suspicious_fast_answers Int                  @default(0)
  previous_band           Float
  estimated_band          Float
  band_change             String
  confidence_level        String
  skill_breakdown         Json                 @default("{}")
  recommendation          String
  weak_skills             String[]
