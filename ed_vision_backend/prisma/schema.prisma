  accuracy_rate     Float     @default(0)
  recent_sessions   Json      @default("[]")
  weak_topics       String[]
  last_practiced_at DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([enrollment_id, skill_area])
  @@map("IeltsSkillProgress")
}

model IeltsErrorTag {
  id                     Int                   @id @default(autoincrement())
  name                   String                @db.VarChar(120)
  skill                  String                @db.VarChar(30)
  severity               Int                   @default(3)
  improvement_suggestion String?
  explanation            String?
  recommended_action     String?
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @updatedAt @db.Timestamptz(6)
  recommendations        IeltsRecommendation[]
  weak_points            IeltsWeakPoint[]

  @@map("IeltsErrorTag")
}

model IeltsWeakPoint {
  id            Int                   @id @default(autoincrement())
  enrollment_id Int
  error_tag_id  Int
  occurrences   Int                   @default(1)
  last_seen_at  DateTime              @default(now()) @db.Timestamptz(6)
  is_active     Boolean               @default(true)
  resolved_at   DateTime?             @db.Timestamptz(6)
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at    DateTime              @updatedAt @db.Timestamptz(6)
  enrollment    CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  error_tag     IeltsErrorTag         @relation(fields: [error_tag_id], references: [id])

  @@unique([enrollment_id, error_tag_id])
  @@map("IeltsWeakPoint")
}

model IeltsRecommendation {
  id            Int                   @id @default(autoincrement())
  enrollment_id Int
  type          String                @db.VarChar(30)
  title         String                @db.VarChar(200)
  reason        String?
  lesson_id     Int?
  skill         String?               @db.VarChar(30)
  error_tag_id  Int?
  priority      Int                   @default(3)
  is_active     Boolean               @default(true)
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at    DateTime              @updatedAt @db.Timestamptz(6)
  enrollment    CertificateEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  error_tag     IeltsErrorTag?        @relation(fields: [error_tag_id], references: [id])

  @@map("IeltsRecommendation")
}

enum MeetingType {
  online
  offline
  both
}

enum RecipientRole {
  booker
  instructor
}

enum PlacementStatus {
  in_progress
  completed
  abandoned
}

enum ConfidenceLevel {
  low
  medium
  high
}
