# OpenRouter API (thay thế Gemini 2.0 cho vocab import)
# Lấy API key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=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
# Vision models cho image mapping (Part 3/4 TOEIC Listening):
#   google/gemma-3-27b-it  (khuyến nghị — Gemma 4 khi available)
#   google/gemini-flash-1.5-8b  (nhanh, hỗ trợ vision)
#   meta-llama/llama-3.2-11b-vision-instruct:free  (open source, vision)
#   qwen/qwen2-vl-7b-instruct:free  (tốt cho tiếng Việt)
OPENROUTER_MODEL_NAME=google/gemma-3-27b-it
# Text model cho AI Tutor (nhận xét kỹ năng, giải thích đáp án):
#   qwen/qwen3-30b-a3b  (nhanh, rẻ, tốt tiếng Việt — mặc định)
#   meta-llama/llama-3.3-70b-instruct  (mạnh hơn, chậm hơn)
#   google/gemma-3-12b-it  (nhẹ, nhanh)
OPENROUTER_TUTOR_MODEL=google/gemma-4-26b-a4b-it:free

# AI Tutor provider: openrouter (mặc định, nhanh) | ollama (local, cần ollama serve)
AI_TUTOR_PROVIDER=openrouter

POLL_INTERVAL_MS=30000
POLL_BATCH_SIZE=200
ETL_RETRY_LIMIT=5
EVENT_CHANNEL=event_channel
