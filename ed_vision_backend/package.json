  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node scripts/start_clean_port3000.js",
    "start:clean": "node scripts/start_clean_port3000.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:prod:migrate": "npx prisma migrate deploy && node dist/main",
    "cleanup:toeic-repository": "node scripts/cleanup_legacy_toeic_repository.js",
    "cleanup:toeic-repository:apply": "node scripts/cleanup_legacy_toeic_repository.js --apply",
    "purge:toeic-data": "node scripts/purge_toeic_data.js",
    "purge:toeic-data:apply": "node scripts/purge_toeic_data.js --apply",
    "purge:toeic-data:apply:with-cache": "node scripts/purge_toeic_data.js --apply --clear-ai-cache",
    "webhook:listen": "node src/etl/listener.js",
    "webhook:poll": "node src/etl/poller.js",
    "seed:ielts": "node prisma/seed-ielts-full.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
