# ============================================================
# Bổ sung các biến này vào file .env hiện tại của backend khi
# expose qua Cloudflare Tunnel (https://www.teamnghiencuu.id.vn).
# ============================================================

# Cho phép origin từ tunnel + local dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://www.teamnghiencuu.id.vn,https://teamnghiencuu.id.vn

# Cloudflared = reverse proxy => bật trust proxy để lấy đúng client IP, scheme
TRUST_PROXY=true
