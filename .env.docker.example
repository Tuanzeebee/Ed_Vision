COMPOSE_PROJECT_NAME=edvision-prod
TZ=Asia/Ho_Chi_Minh

GATEWAY_HTTP_PORT=80
BACKEND_REPLICAS=2
ML_REPLICAS=1

FRONTEND_PUBLIC_API_URL=
FRONTEND_PUBLIC_SOCKET_BASE_URL=
FRONTEND_PUBLIC_UPLOADS_BASE_URL=

POSTGRES_DB=edvision
POSTGRES_USER=edvision_app
POSTGRES_PASSWORD=change_me_postgres

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_root
MONGO_APP_DB=ed_vision
MONGO_APP_USER=edvision_app
MONGO_APP_PASSWORD=change_me_mongo_app

REDIS_PASSWORD=change_me_redis
REDIS_MAXMEMORY=512mb
REDIS_KEY_PREFIX=edvision

CORS_ORIGINS=https://your-domain.example,http://localhost:5173
TRUST_PROXY=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

OTP_RESEND_COOLDOWN_SECONDS=30
OTP_WINDOW_MINUTES=30
OTP_MAX_PER_WINDOW=10

PYTHON_ML_API_URL=http://ml-service:8000
ML_WORKERS=1
SHAP_CACHE_TTL_MINUTES=15

BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=

POLL_INTERVAL_MS=30000
POLL_BATCH_SIZE=200
ETL_RETRY_LIMIT=5
EVENT_CHANNEL=event_channel
